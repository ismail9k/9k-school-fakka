{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fakka",
  "compatibility_date": "2026-10-03",
  // Static-only Worker: serves the Next.js export in ./out
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
