{
  "name": "fakka",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "next build && wrangler d1 migrations apply fakka-waitlist --local && wrangler dev",
    "deploy": "node scripts/check-release-env.mjs && next build && wrangler d1 migrations apply fakka-waitlist --remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply fakka-waitlist --local",
    "db:migrate:remote": "wrangler d1 migrations apply fakka-waitlist --remote",
    "db:migrate:preview": "wrangler d1 migrations apply PREVIEW_DB --remote --config wrangler.preview-migrations.jsonc",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "next": "16.3.8",
    "next-intl": "^4.14.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3",
    "wrangler": "^4.146.0"
  },
  "engines": { "node": ">=22.5" },
  "packageManager": "pnpm@11.10.0"
}
